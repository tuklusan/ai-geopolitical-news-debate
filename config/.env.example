# Live News Debate Wall - configuration example.
#
# Copy this file to config/.env and fill in your own values.
# The real .env file is git-ignored and MUST NEVER be committed.
#
# The OpenAI-compatible API key is read from configuration only.
# It is never hard-coded, stored in SQLite, displayed, logged,
# or included in test output.

# OpenAI-compatible LLM configuration (defaults shown).
LLM_BASE_URL=https://integrate.api.nvidia.com/v1
# The model this project was originally built and blogged about,
# z-ai/glm-5.2, was retired by NVIDIA on 2026-08-21 and now returns
# HTTP 410. The default below is a small model that is known to work on
# that endpoint, but its persona writing is noticeably weaker.
#
# Any OpenAI-compatible endpoint works. For output closer to the blog,
# point LLM_BASE_URL at a provider that still serves a large GLM model,
# for example OpenRouter:
#   LLM_BASE_URL=https://openrouter.ai/api/v1
#   LLM_MODEL=z-ai/glm-4.6
# See "Choosing a model" in README.md.
LLM_MODEL=nvidia/nemotron-mini-4b-instruct
LLM_TEMPERATURE=0.55
LLM_MAX_TOKENS=140
LLM_TIMEOUT_SECONDS=90

# API key. REQUIRED for model generation.
# When absent the app starts the HTTP server, continues RSS processing,
# reports that model generation is unavailable, and skips doomed requests.
LLM_API_KEY=replace-with-your-real-api-key

# RSS feed (France 24 English business news).
RSS_FEED_URL=https://www.france24.com/en/business/rss

# HTTP server bind address.
HOST=0.0.0.0
PORT=8765

# Path to the SQLite database file.
DB_PATH=live_news_wall.db

# Interval (seconds) between periodic RSS refreshes.
RSS_REFRESH_INTERVAL_SECONDS=300

# Minimum seconds between visible conversation messages (randomized 3-6).
MESSAGE_MIN_DELAY_SECONDS=3
MESSAGE_MAX_DELAY_SECONDS=6

# Number of visible turns a headline is discussed before the wall moves on
# to the next queued item (or revisits an older one from a fresh angle).
TOPIC_TURNS_MIN=8
TOPIC_TURNS_MAX=12

# Maximum concurrent HTTP requests. Excess requests get a small 503 with
# Retry-After rather than being queued.
MAX_CLIENTS=1024

# How many past feed items to keep. Older ones are pruned after each
# refresh so the revisit pool stays recent. Minimum 10.
FEED_RETENTION_ITEMS=500
