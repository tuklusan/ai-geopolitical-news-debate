# Live News Debate Wall - configuration example.
#
# Copy this file to config/.env and fill in your own values.
# The real .env file is git-ignored and MUST NEVER be committed.
#
# The OpenAI-compatible API key is read from configuration only.
# It is never hard-coded, stored in SQLite, displayed, logged,
# or included in test output.

# OpenAI-compatible LLM configuration (defaults shown).
LLM_BASE_URL=https://integrate.api.nvidia.com/v1
# Free on NVIDIA's hosted endpoint (build.nvidia.com), which is where this
# project runs. It scored 12/12 against the wall's own validator and holds
# all four personas well. Get a key at build.nvidia.com.
#
# The model the blog was originally written with, z-ai/glm-5.2, was retired
# from this endpoint on 2026-08-21. Any OpenAI-compatible endpoint works.
# See "Choosing a model" in README.md for measured alternatives.
LLM_MODEL=deepseek-ai/deepseek-v4-flash-0731
LLM_TEMPERATURE=0.55
LLM_MAX_TOKENS=400
LLM_TIMEOUT_SECONDS=90

# API key. REQUIRED for model generation.
# When absent the app starts the HTTP server, continues RSS processing,
# reports that model generation is unavailable, and skips doomed requests.
LLM_API_KEY=replace-with-your-real-api-key

# RSS feed (France 24 English business news).
RSS_FEED_URL=https://www.france24.com/en/business/rss

# HTTP server bind address.
HOST=0.0.0.0
PORT=8765

# Path to the SQLite database file.
DB_PATH=live_news_wall.db

# Interval (seconds) between periodic RSS refreshes.
RSS_REFRESH_INTERVAL_SECONDS=300

# Minimum seconds between visible conversation messages (randomized 3-6).
MESSAGE_MIN_DELAY_SECONDS=3
MESSAGE_MAX_DELAY_SECONDS=6

# Number of visible turns a headline is discussed before the wall moves on
# to the next queued item (or revisits an older one from a fresh angle).
TOPIC_TURNS_MIN=8
TOPIC_TURNS_MAX=12

# Maximum concurrent HTTP requests. Excess requests get a small 503 with
# Retry-After rather than being queued.
MAX_CLIENTS=1024

# How many past feed items to keep. Older ones are pruned after each
# refresh so the revisit pool stays recent. Minimum 10.
FEED_RETENTION_ITEMS=500

# Speed of the on-screen typewriter effect, in characters per second.
# The conversation engine waits the same length of time before requesting
# the next turn, so lowering this also lowers how often the model is
# called. Must be greater than 0.
TYPING_CHARS_PER_SECOND=25

# How many transcript messages to keep. Older ones are pruned, along with
# the speaker history and any topic no retained message refers to, so the
# database cannot grow without bound on a wall left running for months.
# The browser renders far fewer than this. Minimum 100.
TRANSCRIPT_RETENTION_MESSAGES=5000

# Optional. Leave empty to log only to stderr (systemd captures that into
# the journal, which rotates on its own). Set a path to also write a
# size-capped rotating file, which is what a `nohup` deployment wants.
LOG_FILE=
LOG_MAX_BYTES=5242880
LOG_BACKUP_COUNT=3
